*/.ipynb_checkpoints/*

# --- Data (tracked via DVC / external storage, not git) ---
data/raw/**
data/interim/**
data/processed/**
data/labels/**
data/external/**
!data/raw/**/.gitkeep
!data/interim/**/.gitkeep
!data/processed/**/.gitkeep
!data/labels/**/.gitkeep
!data/external/**/.gitkeep

# --- Models & large artifacts ---
models/checkpoints/**
models/artifacts/**
