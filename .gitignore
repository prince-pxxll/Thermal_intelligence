!models/artifacts/.gitkeep
*.ckpt
*.pt
*.pth
*.h5
*.pkl
*.joblib

# --- Experiment tracking ---
experiments/runs/**
!experiments/runs/.gitkeep
mlruns/
wandb/

# --- Results (generated, not source) ---
results/figures/**
results/tables/**
results/metrics/**
results/reports/**
!results/figures/.gitkeep
!results/tables/.gitkeep
!results/metrics/.gitkeep
!results/reports/.gitkeep

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Geospatial caches ---
*.gpkg-wal
*.gpkg-shm
.geocache/
