# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- NASA FIRMS (Fire Information for Resource Management System) ---
FIRMS_MAP_KEY=your_firms_map_key_here
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# --- Sentinel / Copernicus Data Space ---
COPERNICUS_CLIENT_ID=your_client_id_here
COPERNICUS_CLIENT_SECRET=your_client_secret_here

# --- OpenStreetMap / Overpass ---
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --- Region of interest ---
REGION_CONFIG_PATH=config/regions/maharashtra.yaml

# --- Storage ---
DATA_ROOT=./data
MODELS_ROOT=./models
RESULTS_ROOT=./results

# --- API service (api/app) ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# --- Experiment tracking (optional) ---
MLFLOW_TRACKING_URI=
WANDB_API_KEY=
WANDB_PROJECT=thermal-intelligence-maharashtra

# --- Misc ---
RANDOM_SEED=42
ENVIRONMENT=development
