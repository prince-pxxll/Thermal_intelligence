# Normalize line endings
* text=auto eol=lf

# Notebooks: diff cleanly (requires nbdime/jq filter configured locally, harmless otherwise)
*.ipynb text eol=lf

# Explicit binary types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.parquet binary
*.gpkg binary
*.tif binary
*.tiff binary
*.h5 binary
*.pkl binary
*.joblib binary
*.pt binary
*.pth binary

